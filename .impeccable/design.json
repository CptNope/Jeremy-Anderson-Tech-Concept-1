  "narrative": {
    "northStar": "The Calibrated Instrument",
    "overview": "Every page is a modern digital oscilloscope screen. A graticule-black ground carries faint 10 × 8 measurement divisions; one beam-drawn trace arrives unsettled, triggers, and locks steady. The JAT monogram is that trace: a step response whose transient spells J, A and T.",
    "keyCharacteristics": ["Graticule-black ground with 10 × 8 divisions and centre-axis tick rulers on signature screens","One trace, one lock sequence per page; canvases stop drawing when settled","Channel colors as identifiers (CH1 cyan, CH2 ultraviolet, CH3 amber, CH4 signal)","Expanded grotesk display, normal-width body, mono only for data","Hairline frames, small radii, no decorative shadows"],
    "rules": [
      { "name": "The Identifier Rule", "body": "Channel colors label a service line or a state. They never fill large areas, never tint body text, and always travel with their CH number and name.", "section": "colors" },
      { "name": "The Cyan-Carries-Ink Rule", "body": "Text on Channel Cyan is always Graticule (12.5:1).", "section": "colors" },
      { "name": "The Data-Only Mono Rule", "body": "Martian Mono appears only when the content is data. A headline in mono is a costume.", "section": "typography" },
      { "name": "The Bezel Rule", "body": "Glass exists only where a trace moves beneath it. It is never a card style.", "section": "elevation" }
    ],
    "dos": ["Do draw systems as single-stroke trace diagrams on a graticule, labeled in Martian Mono.","Do keep channel color to identifiers with their CH number and name.","Do publish prices and timings in mono readouts.","Do stop canvases once the trace has locked."],
    "donts": ["Don't add glows, bloom or gradients to the monogram or traces.","Don't use glowing brains, particle spheres, padlocks, binary rain or AI-generated people.","Don't place kicker labels above headings; channel IDs sit inline with names.","Don't use glass as a card style or monospace for headlines."]
