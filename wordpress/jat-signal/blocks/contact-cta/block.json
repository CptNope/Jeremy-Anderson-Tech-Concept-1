{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/contact-cta",
	"version": "1.0.0",
	"title": "Contact CTA",
	"category": "jat",
	"icon": "email",
	"description": "Call to action section with heading, description, and contact button.",
	"keywords": [
		"contact",
		"cta",
		"call to action",
		"email"
	],
	"supports": {
		"html": false,
		"align": [
			"full"
		],
		"anchor": true,
		"className": true
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"heading": {
			"type": "string",
			"default": "Let's Build Something"
		},
		"headingHighlight": {
			"type": "string",
			"default": "Amazing"
		},
		"description": {
			"type": "string",
			"default": "Got a project in mind? I'm always open to discussing new opportunities, collaborations, and interesting ideas."
		},
		"buttonText": {
			"type": "string",
			"default": "Get In Touch ↗"
		},
		"buttonUrl": {
			"type": "string",
			"default": "mailto:info@jeremyanderson.tech"
		},
		"secondaryButtonText": {
			"type": "string",
			"default": ""
		},
		"secondaryButtonUrl": {
			"type": "string",
			"default": ""
		},
		"showEmail": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "jat-signal",
	"editorScript": "jat-blocks-editor",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}