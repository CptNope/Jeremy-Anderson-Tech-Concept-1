{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/hero-section",
	"version": "1.0.0",
	"title": "Hero Section",
	"category": "jat",
	"icon": "superhero-alt",
	"description": "Full-screen hero with name, role, description, and CTA buttons.",
	"keywords": [
		"hero",
		"banner",
		"intro"
	],
	"supports": {
		"html": false,
		"align": [
			"full"
		],
		"anchor": true,
		"className": true
	},
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"badgeText": {
			"type": "string",
			"default": "✨ Available for freelance work"
		},
		"name": {
			"type": "string",
			"default": "Jeremy Anderson"
		},
		"role": {
			"type": "string",
			"default": "{ Full-Stack Developer }"
		},
		"description": {
			"type": "string",
			"default": "I craft performant, accessible, and beautifully designed web experiences. Passionate about clean code, modern architectures, and pushing the boundaries of what's possible on the web."
		},
		"primaryButtonText": {
			"type": "string",
			"default": "View My Work"
		},
		"primaryButtonUrl": {
			"type": "string",
			"default": "/projects"
		},
		"secondaryButtonText": {
			"type": "string",
			"default": "About Me"
		},
		"secondaryButtonUrl": {
			"type": "string",
			"default": "/about"
		},
		"roles": {
			"type": "string",
			"default": "Full-Stack Developer, WordPress Engineer, AI Systems Builder, Cybersecurity Specialist, Cloud Architect"
		},
		"note": {
			"type": "string",
			"default": ""
		},
		"showChannels": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "jat-signal",
	"editorScript": "jat-blocks-editor",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}