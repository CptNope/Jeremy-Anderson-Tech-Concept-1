{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "developer-portfolio/services-addons",
	"version": "1.0.0",
	"title": "Services Add-Ons",
	"category": "jat",
	"icon": "plus-alt",
	"description": "Grid of à la carte add-on services pulling from the Services CPT.",
	"keywords": [
		"addons",
		"add-ons",
		"services",
		"extras"
	],
	"supports": {
		"html": false,
		"align": [
			"full"
		],
		"anchor": true,
