		"align": {
			"type": "string",
			"default": "full"
		},
		"sectionTag": {
			"type": "string",
			"default": "Add-Ons"
		},
		"heading": {
			"type": "string",
			"default": "À La Carte Services"
		},
		"intro": {
			"type": "string",
			"default": "Standalone deliverables that can be added to any project or purchased independently."
		},
		"category": {
			"type": "string",
			"default": "add-ons"
		}
	},
	"textdomain": "jat-signal",
	"editorScript": "jat-blocks-editor",
	"render": "file:./render.php",
	"usesContext": [
		"postId",
		"postType"
	]
}