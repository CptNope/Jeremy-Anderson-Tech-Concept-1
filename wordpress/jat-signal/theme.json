		"custom": {
			"fontWeight": {
				"light": 400,
				"regular": 400,
				"medium": 500,
				"semibold": 600,
				"bold": 640,
				"extrabold": 700
			},
			"borderRadius": {
				"sm": "2px",
				"md": "6px",
				"lg": "8px",
				"xl": "12px",
				"2xl": "12px",
				"3xl": "16px",
				"full": "9999px"
			},
			"gap": {
				"baseline": "1.5rem",
				"horizontal": "min(1.5rem, 4vw)",
				"vertical": "min(4rem, 8vh)"
			},
			"measure": "32em",
			"gutter": "clamp(16px, 4vw, 48px)",
			"header": "68px"
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			},
			"core/pullquote": {
				"border": {
					"color": true,
					"radius": true,
					"style": true,
					"width": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--graticule)",
			"text": "var(--wp--preset--color--ice)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--archivo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(16px, 4vw, 48px)",
				"right": "clamp(16px, 4vw, 48px)",
				"top": "0",
				"bottom": "0"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ch1)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ch1)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--archivo-wide)",
					"fontWeight": "620",
					"lineHeight": "1.05"
				},
				"color": {
					"text": "var(--wp--preset--color--ice)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--page)",
					"fontWeight": "640",
					"lineHeight": "0.95",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--section)",
					"fontWeight": "620",
					"lineHeight": "1.05",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--title)",
					"fontWeight": "600",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--item)",
					"fontWeight": "600",
					"lineHeight": "1.35"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--martian-mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "400",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--ice-muted)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ch1)",
					"text": "var(--wp--preset--color--graticule)"
				},
				"border": {
					"radius": "6px",
					"width": "1px",
					"style": "solid",
					"color": "transparent"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--archivo-wide)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.25"
				},
				"spacing": {
					"padding": {
						"top": "0.875rem",
						"bottom": "0.875rem",
						"left": "1.25rem",
						"right": "1.25rem"
					}
				},
				":hover": {
					"color": {
						"background": "#7AEDF6",
						"text": "var(--wp--preset--color--graticule)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ch1)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--ice-subtle)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"cite": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--martian-mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase",
					"fontStyle": "normal"
				},
				"color": {
					"text": "var(--wp--preset--color--ice-muted)"
				}
			}
		},
		"blocks": {
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--ink-950)",
					"text": "var(--wp--preset--color--ice)"
				},
				"typography": {
