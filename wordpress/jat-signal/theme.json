					"shadow": "0 1px 0 rgba(255,255,255,0.03) inset, 0 8px 24px rgba(0,0,0,0.35)"
				},
				{
					"slug": "violet-sm",
					"name": "Legacy · Small",
					"shadow": "0 4px 14px rgba(0,0,0,0.28)"
				},
				{
					"slug": "violet-md",
					"name": "Legacy · Medium",
					"shadow": "0 8px 25px rgba(0,0,0,0.32)"
